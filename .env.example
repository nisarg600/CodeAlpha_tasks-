# Server Port
PORT=3000

# Active Provider: "free", "google", or "azure"
# "free" uses the high-quality MyMemory Translation API (no credit card or API key required)
TRANSLATION_PROVIDER=free

# --- Google Cloud Translation Credentials (Optional) ---
# 1. Go to https://console.cloud.google.com/
# 2. Enable "Cloud Translation API"
# 3. Create an API key under Credentials
GOOGLE_TRANSLATE_API_KEY=

# --- Microsoft Azure Translator Credentials (Optional) ---
# 1. Go to https://portal.azure.com/
# 2. Create a "Translator" Cognitive Service resource
# 3. Copy the Key and Region under "Keys and Endpoint"
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
